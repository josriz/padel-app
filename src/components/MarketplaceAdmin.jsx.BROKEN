import React, { useState, useEffect } from "react";
import { supabase } from "../supabaseClient";
import { Loader2 } from "lucide-react";
import { useAuth } from "../context/AuthProvider";
import { formatPrice } from "./marketplaceUtils";

export default function MarketplaceAdmin() {
  const { user } = useAuth();
  const [items, setItems] = useState([]);
  const [loading, setLoading] = useState(true);
  const [deletingId, setDeletingId] = useState(null);

  const fetchItems = async () => {
    setLoading(true);
    try {
      const { data, error } = await supabase
        .from("marketplace_items")
        .select("*")
        .eq("is_active", true) // solo articoli attivi
        .order("created_at", { ascending: false });

      if (error) throw error;
      setItems(data || []);
    } catch (err) {
      console.error("Errore fetch marketplace:", err);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchItems();
  }, []);

  const deleteItem = async (id) => {
    if (!confirm("Eliminare articolo?")) return;
    setDeletingId(id);
    try {
      const { error } = await supabase
        .from('marketplace_items')
        .delete()
        .eq('id', id);

      if (error) throw error;
      setItems(items.filter(i => i.id !== id));
    } catch (err) {
      alert('❌ Errore: ' + err.message);
      fetchItems();
    } finally {
      setDeletingId(null);
    }
  };

  if (loading) {
    return (
      <div className="min-h-screen flex items-center justify-center">
        <Loader2 className="w-12 h-12 animate-spin text-emerald-600" />
      </div>
    );
  }

  const totalSales = items.reduce((sum, i) => sum + (i.prezzo || 0), 0);
  const totalProfit = items.reduce(
    (sum, i) => sum + ((i.prezzo || 0) * ((i.profit_percent || 0) / 100)),
    0
  );

  return (
    <div className="p-6 max-w-6xl mx-auto space-y-8">
      <h2 className="text-3xl font-bold text-center mb-6">🛒 Gestione Marketplace</h2>

      {/* Statistiche */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
        <div>
          <p className="text-3xl font-black">{items.length}</p>
          <p>Totale articoli</p>
        </div>
        <div>
          <p className="text-3xl font-black">{formatPrice(totalSales)}</p>
          <p>Totale vendite</p>
        </div>
        <div>
          <p className="text-3xl font-black">{formatPrice(totalProfit)}</p>
          <p>Totale guadagni</p>
        </div>
      </div>

      {/* Lista articoli */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
        {items.map(item => (
          <div key={item.id} className="bg-white p-4 rounded-xl shadow-md relative">
            {item.immagine_url && (
              <img
                src={item.immagine_url}
                alt={item.nome}
                className="w-full h-48 object-cover rounded-lg mb-3"
              />
            )}
            <h3 className="font-bold text-xl mb-2">{item.nome}</h3>
            <p>Prezzo: {formatPrice(item.prezzo)}</p>
            <p>Guadagno admin: {item.profit_percent || 0}%</p>

            <button
              onClick={() => deleteItem(item.id)}
              disabled={deletingId === item.id}
              className="absolute top-3 right-3 text-red-600 hover:text-red-800 font-bold"
            >
              {deletingId === item.id ? "..." : "Elimina"}
            </button>
          </div>
        ))}
      </div>
    </div>
  );
}
